# Copy to .env and fill in. NEVER commit .env.

# --- LLM provider ---
# openrouter (default, cloud) or ollama (local)
PDF2STUDY_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# Local Ollama (used when provider=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# --- Cloudflare R2 ---
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=pdf-study-storage

# Optional: separate PUBLIC bucket for figures only (NEVER make the main bucket
# public - it contains raw chunks/book text). Its public base URL is used to
# rewrite figure links when publishing to the MkDocs site.
R2_PUBLIC_BUCKET=
IMAGE_BASE_URL=
